# Keep secrets and local files out of a public repository.
# Keys live in environment variables (see guide-environnement-etudiant-en.md).
# Copy this file to the root of your repository if that root is not kit-td1.
.env
.env.*
*.env
.envrc
*.key
*.pem
secrets*
credentials*
ready-for-td1.txt

# Virtual environments and Python caches
.venv/
venv/
__pycache__/
*.pyc

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# The distributed dataset stays local. The public repository keeps only its
# hashes and the instructions for obtaining it from the official student kit.
data/*.sqlite
data/*.csv

